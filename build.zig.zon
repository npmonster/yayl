.{
    .name = .yayl,
    .fingerprint = 0xc49f7ed1a8db0b85,
    .version = "0.17.0",
    .minimum_zig_version = "0.16.0",
    .description = "A YAML 1.2 parser, document model and emitter for Zig. Edits re-emit byte-faithfully: untouched bytes, comments and layout survive.",
    .license = "MIT",
    .paths = .{
        "AGENTS.md",
        "build.zig",
        "build.zig.zon",
        "CHANGELOG.md",
        "CONTRIBUTING.md",
        "docs/design/comments.md",
        "docs/USAGE.md",
        "examples",
        "LICENSE",
        "README.md",
        "src",
    },
}
